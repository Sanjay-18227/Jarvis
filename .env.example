# JARVIS Environment Configuration (copy to .env and edit)
# Local-first defaults: no utterance, screenshot or document leaves this laptop
# unless you explicitly opt in below.

# ---------------------------------------------------------------- Persona
OWNER_NAME=Sanjay
ASSISTANT_NAME=JARVIS
PREFERRED_TITLE=Sir

# ---------------------------------------------------------------- Privacy policy
# LOCAL_ONLY=true blocks cloud reasoning, remote vision and remote STT.
LOCAL_ONLY=true
# Explicit opt-ins (keep false for a fully local setup):
ALLOW_REMOTE_LLM=false
ALLOW_REMOTE_VISION=false

# ---------------------------------------------------------------- Local model stack
# Models live under ./models by default; override with an absolute path if needed.
MODEL_DIR=
# Heavy models are unloaded after this many idle seconds.
MODEL_UNLOAD_IDLE_SECONDS=300
# SLM intent backend: auto (transformers) | off
SLM_NEURAL_BACKEND=
SLM_ENABLED=true
SLM_MODEL=qwen3-0.6b
SLM_MODE=non_thinking
SLM_MAX_TOKENS=128
# Faster-Whisper backend and size (tiny | base)
ASR_LOCAL_BACKEND=faster-whisper
ASR_LOCAL_MODEL=tiny
# Local TTS selection: auto | pyttsx3 | edge (edge_tts needs network)
TTS_LOCAL_ENGINE=auto

# ---------------------------------------------------------------- Cloud reasoning (optional, disabled by default)
# Only used when ALLOW_REMOTE_LLM=true.
PRIMARY_REASONING_PROVIDER=openrouter
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODELS=openrouter/free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------- Vision
# VISION_PROVIDER=gemini (remote, requires ALLOW_REMOTE_VISION=true)
# VISION_PROVIDER=local  (SmolVLM-256M, opt-in; download + enable in registry)
# Any unavailable provider falls back to local UI Automation/window inspection.
VISION_ENABLED=true
VISION_PROVIDER=gemini
VISION_CAPTURE_MODE=active_window
VISION_SAVE_SCREENSHOTS=false
VISION_SCREENSHOTS_DIR=
VISION_CACHE_SECONDS=2.0
VISION_REQUIRE_OWNER=true

# ---------------------------------------------------------------- Voice transport
# livekit (cloud transport) | legacy (local microphone/speaker)
VOICE_PROVIDER=legacy
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- Speech recognition
# local (faster-whisper) is the default. groq_whisper/google require network.
STT_ENGINE=local
STT_LANGUAGE=en-US
STT_TIMEOUT_SECONDS=10.0
STT_PHRASE_TIME_LIMIT=60.0

# ---------------------------------------------------------------- Speech synthesis
# edge_tts (network) is the quality default; pyttsx3 is fully offline.
TTS_ENGINE=edge_tts
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0Hz

# ---------------------------------------------------------------- VAD & speaker biometrics
VAD_SPEECH_THRESHOLD=400
VAD_MIN_SPEECH_MS=250
VAD_END_SILENCE_MS=1500
VAD_NOISE_CALIBRATION_SECONDS=0.5
DYNAMIC_ENERGY_THRESHOLD=true
SILENCE_THRESHOLD_SECONDS=1.5
MAX_RECORD_SECONDS=60.0

# Thresholds are never lowered automatically. Raise OWNER_SIMILARITY_THRESHOLD
# to make voice authentication stricter; do not lower without a documented reason.
OWNER_SIMILARITY_THRESHOLD=0.78
UNCERTAIN_SIMILARITY_THRESHOLD=0.70

# ---------------------------------------------------------------- Wake word & barge-in
WAKE_WORD=hey jarvis
WAKE_WORD_ENGINE=openwakeword
BARGE_IN_ENABLED=true
BARGE_IN_COOLDOWN_SECONDS=0.25

# ---------------------------------------------------------------- Security & audit
DEFAULT_PERMISSION_LEVEL=OWNER
REQUIRE_CONFIRMATION_RISK_LEVEL=3
AUDIT_LOG_ENABLED=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Desktop
DEFAULT_BROWSER=edge
