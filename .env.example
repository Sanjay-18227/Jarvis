# User & Persona Settings
OWNER_NAME=Sanjay
ASSISTANT_NAME=JARVIS
PREFERRED_TITLE=Sir

# AI Provider Configuration (Options: openrouter | gemini | groq)
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Primary AI Brain)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini Configuration (Multimodal & Screen Vision)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
SCREEN_VISION_ENABLED=false

# Groq Configuration (Fast Inference & Groq Whisper STT)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Voice Session Layer (Options: livekit | legacy)
VOICE_PROVIDER=livekit
LIVEKIT_URL=wss://your-livekit-server.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Speech Recognition (STT) (Options: groq_whisper | google | local)
STT_ENGINE=groq_whisper
STT_LANGUAGE=en-US

# Speech Synthesis (TTS) (Options: edge_tts | elevenlabs | pyttsx3)
TTS_ENGINE=edge_tts
TTS_VOICE=en-US-AndrewMultilingualNeural

# VAD Calibration & Speaker Biometrics
VAD_SPEECH_THRESHOLD=400
VAD_MIN_SPEECH_MS=250
VAD_END_SILENCE_MS=1500
OWNER_SIMILARITY_THRESHOLD=0.78
UNCERTAIN_SIMILARITY_THRESHOLD=0.70

# ElevenLabs (Optional)
ELEVENLABS_API_KEY=
