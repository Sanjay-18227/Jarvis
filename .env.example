# User & Persona Settings
OWNER_NAME=Sanjay
ASSISTANT_NAME=JARVIS
PREFERRED_TITLE=Sir

# AI Provider Configuration (Options: openrouter | gemini | groq | ollama)
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Ollama Configuration (Offline Mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Speech Recognition (STT) (Options: groq_whisper | google | local)
STT_ENGINE=groq_whisper
STT_LANGUAGE=en-US

# Speech Synthesis (TTS) (Options: edge_tts | elevenlabs | pyttsx3)
TTS_ENGINE=edge_tts
TTS_VOICE=en-US-AndrewMultilingualNeural

# ElevenLabs (Optional)
ELEVENLABS_API_KEY=
