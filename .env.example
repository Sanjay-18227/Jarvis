# ========================================================
# JARVIS Configuration Environment Template
# ========================================================

# User & Persona Settings
OWNER_NAME=Sanjay
ASSISTANT_NAME=JARVIS
PREFERRED_TITLE=Sir

# AI Provider Configuration (Selected: Groq)
# Supported providers: groq, gemini, openai, ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Fast alternative: llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo

# Optional Fallback Providers
GEMINI_API_KEY=
OPENAI_API_KEY=

# Voice Input / STT Configuration
# stt_engine: groq_whisper | google | local
STT_ENGINE=groq_whisper
STT_LANGUAGE=en-US
STT_TIMEOUT_SECONDS=6.0
STT_PHRASE_TIME_LIMIT=12.0
ENERGY_THRESHOLD=350
DYNAMIC_ENERGY_THRESHOLD=true

# Voice Output / TTS Configuration
# tts_engine: edge_tts | pyttsx3 | elevenlabs
TTS_ENGINE=edge_tts
TTS_VOICE=en-US-ChristopherNeural
# Alternate voices:
# English: en-US-ChristopherNeural, en-US-GuyNeural
# Tamil: ta-IN-ValluvarNeural
# Hindi: hi-IN-MadhurNeural
TTS_RATE=+0%
TTS_VOLUME=+0%
TTS_PITCH=+0%

# Wake Word Settings (Phase 2+)
WAKE_WORD=hey jarvis
WAKE_WORD_ENGINE=openwakeword

# Security & Permissions
DEFAULT_PERMISSION_LEVEL=OWNER
REQUIRE_CONFIRMATION_RISK_LEVEL=3
AUDIT_LOG_ENABLED=true
LOG_LEVEL=INFO
